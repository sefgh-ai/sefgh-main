    {
      "id": "filter-license-with-dot",
      "disposition": "preserve",
      "note": "R-017: license keys may hold dots and hyphens. Version 4, Go only: the Next.js handler ignores the parameter until it is retired, so next_expect_upstream_url and next_expect hold what it does (an unfiltered search).",
      "request": "q=react&license=apache-2.0",
      "upstream": "empty",
      "expect_upstream_url": "q=react%20license%3Aapache-2.0&sort=&order=desc&page=1&per_page=30",
      "expect": "empty_ok",
      "next_expect_upstream_url": "q=react&sort=&order=desc&page=1&per_page=30",
      "next_expect": "empty_ok"
    },
    {
      "id": "filter-created-after",
      "disposition": "preserve",
      "note": "R-017: the date range arrives as a comparison and a date, computed by the browser. Version 4, Go only: the Next.js handler ignores the parameter until it is retired, so next_expect_upstream_url and next_expect hold what it does (an unfiltered search).",
      "request": "q=react&created=%3E2026-10-21",
      "upstream": "empty",
      "expect_upstream_url": "q=react%20created%3A%3E2026-10-21&sort=&order=desc&page=1&per_page=30",
      "expect": "empty_ok",
      "next_expect_upstream_url": "q=react&sort=&order=desc&page=1&per_page=30",
      "next_expect": "empty_ok"
    },
    {
      "id": "filter-created-range",
      "disposition": "preserve",
      "note": "R-017: a date range is accepted too. Version 4, Go only: the Next.js handler ignores the parameter until it is retired, so next_expect_upstream_url and next_expect hold what it does (an unfiltered search).",
      "request": "q=react&created=2026-01-01..2026-06-30",
      "upstream": "empty",
      "expect_upstream_url": "q=react%20created%3A2026-01-01..2026-06-30&sort=&order=desc&page=1&per_page=30",
