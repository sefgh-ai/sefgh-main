    {
      "id": "filter-license",
      "disposition": "preserve",
      "note": "R-017: the navbar's license becomes license:<key>. Version 4, Go only: the Next.js handler ignores the parameter until it is retired, so next_expect_upstream_url and next_expect hold what it does (an unfiltered search).",
      "request": "q=react&license=mit",
      "upstream": "empty",
      "expect_upstream_url": "q=react%20license%3Amit&sort=&order=desc&page=1&per_page=30",
