{
  "contract": "GET /api/github/search",
  "contract_version": 5,
  "authorization_contract": "../github-access/cases.json",
  "github_token_semantics": "Per-user GitHub credential, verified with the matching Supabase session; never the server token.",
  "source": "src/app/api/github/search/route.js",
  "upstream_url_prefix": "https://api.github.com/search/repositories?",
  "upstream_request_headers": {
    "without_token": {
      "Accept": "application/vnd.github.v3+json",
      "User-Agent": "SEFGH-NextJS-App"
    },
    "with_token": {
      "Accept": "application/vnd.github.v3+json",
      "User-Agent": "SEFGH-NextJS-App",
      "Authorization": "Bearer test-token"
    }
  },
  "upstream_responses": {
    "one_repo": {
      "status": 200,
      "headers": { "x-ratelimit-remaining": "9", "x-ratelimit-reset": "1760000000" },
      "body": {
        "total_count": 1,
        "incomplete_results": false,
        "items": [
          {
            "id": 10270250,
            "full_name": "facebook/react",
            "html_url": "https://github.com/facebook/react",
            "description": "The library for web and native user interfaces.",
            "stargazers_count": 230000,
            "language": "JavaScript",
            "topics": ["react", "ui"],
            "license": null,
            "owner": { "login": "facebook", "avatar_url": "https://avatars.githubusercontent.com/u/69631?v=4" }
          }
        ]
      }
    },
    "empty": {
      "status": 200,
      "headers": { "x-ratelimit-remaining": "8", "x-ratelimit-reset": "1760000000" },
      "body": { "total_count": 0, "incomplete_results": false, "items": [] }
    },
    "no_rate_limit_headers": {
      "status": 200,
      "headers": {},
      "body": { "total_count": 0, "incomplete_results": false, "items": [] }
    },
    "body_without_expected_fields": {
      "status": 200,
      "headers": { "x-ratelimit-remaining": "7", "x-ratelimit-reset": "1760000000" },
      "body": {}
    },
    "items_not_array": {
      "status": 200,
      "headers": { "x-ratelimit-remaining": "7", "x-ratelimit-reset": "1760000000" },
      "body": { "total_count": 1, "items": { "0": {} } }
    },
    "total_count_not_number": {
      "status": 200,
      "headers": { "x-ratelimit-remaining": "7", "x-ratelimit-reset": "1760000000" },
      "body": { "total_count": "1", "items": [] }
    },
    "null_body": {
      "status": 200,
      "headers": { "x-ratelimit-remaining": "7", "x-ratelimit-reset": "1760000000" },
      "raw_body": "null"
    },
    "invalid_json": {
      "status": 200,
      "headers": { "x-ratelimit-remaining": "7", "x-ratelimit-reset": "1760000000" },
      "raw_body": "<html>bad gateway</html>"
    },
    "unauthorized_401": {
      "status": 401,
      "headers": { "x-ratelimit-remaining": "9", "x-ratelimit-reset": "1760000000" },
      "body": { "message": "Bad credentials" }
    },
    "forbidden_403_primary_limit": {
      "status": 403,
      "headers": { "x-ratelimit-remaining": "0", "x-ratelimit-reset": "1760000000" },
      "body": { "message": "API rate limit exceeded" }
    },
    "forbidden_403_retry_after": {
      "status": 403,
      "headers": { "retry-after": "30", "x-ratelimit-remaining": "12", "x-ratelimit-reset": "1760000000" },
      "body": { "message": "You have exceeded a secondary rate limit" }
    },
    "forbidden_403_other": {
      "status": 403,
      "headers": { "x-ratelimit-remaining": "25", "x-ratelimit-reset": "1760000000" },
      "body": { "message": "Resource not accessible" }
    },
    "unprocessable_422": {
      "status": 422,
      "headers": { "x-ratelimit-remaining": "6", "x-ratelimit-reset": "1760000000" },
      "body": { "message": "Only the first 1000 search results are available" }
    },
    "too_many_429": {
      "status": 429,
      "headers": { "retry-after": "60" },
      "body": { "message": "You have exceeded a secondary rate limit" }
    },
    "server_error_500": {
      "status": 500,
      "headers": {},
      "body": { "message": "Server Error" }
    },
    "network_error": { "network_error": true }
  },
  "responses": {
    "one_repo_ok": {
      "status": 200,
      "body": {
        "total_count": 1,
        "items": [
          {
            "id": 10270250,
            "full_name": "facebook/react",
            "html_url": "https://github.com/facebook/react",
            "description": "The library for web and native user interfaces.",
            "stargazers_count": 230000,
            "language": "JavaScript",
            "topics": ["react", "ui"],
            "license": null,
            "owner": { "login": "facebook", "avatar_url": "https://avatars.githubusercontent.com/u/69631?v=4" }
          }
        ],
        "rate_limit": { "remaining": "9", "reset": "1760000000" }
      }
    },
    "empty_ok": {
      "status": 200,
      "body": { "total_count": 0, "items": [], "rate_limit": { "remaining": "8", "reset": "1760000000" } }
    },
    "empty_ok_null_rate_limit": {
      "status": 200,
      "body": { "total_count": 0, "items": [], "rate_limit": { "remaining": null, "reset": null } }
    },
    "missing_query": { "status": 400, "body": { "error": "Search query is required" } },
    "invalid_parameters": { "status": 400, "body": { "error": "Invalid search parameters" } },
    "upstream_rejected_search": { "status": 400, "body": { "error": "GitHub could not process this search" } },
    "rate_limited_primary": {
      "status": 429,
      "body": {
        "error": "GitHub rate limit reached, please try again shortly",
        "rate_limit": { "remaining": "0", "reset": "1760000000" }
      }
    },
    "rate_limited_retry_after_30": {
      "status": 429,
      "headers": { "retry-after": "30" },
      "body": {
        "error": "GitHub rate limit reached, please try again shortly",
        "rate_limit": { "remaining": "12", "reset": "1760000000" }
      }
    },
    "rate_limited_retry_after_60": {
      "status": 429,
      "headers": { "retry-after": "60" },
      "body": {
        "error": "GitHub rate limit reached, please try again shortly",
        "rate_limit": { "remaining": null, "reset": null }
      }
    },
    "upstream_failure": { "status": 500, "body": { "error": "Failed to search repositories" } }
  },
  "cases": [
    {
      "id": "defaults",
      "disposition": "preserve",
      "note": "Only q supplied: empty sort, desc order, page 1, 30 per page. incomplete_results is dropped; items pass through unmodified.",
      "request": "q=react",
      "upstream": "one_repo",
      "expect_upstream_url": "q=react&sort=&order=desc&page=1&per_page=30",
      "expect": "one_repo_ok"
    },
    {
      "id": "server-token-adds-authorization",
      "disposition": "preserve",
      "note": "A configured server GITHUB_TOKEN is sent as a bearer token; the browser response is unchanged.",
      "request": "q=react",
      "github_token": "test-token",
      "upstream": "one_repo",
      "expect_upstream_url": "q=react&sort=&order=desc&page=1&per_page=30",
      "expect": "one_repo_ok"
    },
    {
      "id": "empty-results",
      "disposition": "preserve",
      "request": "q=zzzznotarepo",
      "upstream": "empty",
      "expect_upstream_url": "q=zzzznotarepo&sort=&order=desc&page=1&per_page=30",
      "expect": "empty_ok"
    },
    {
      "id": "rate-limit-headers-absent",
      "disposition": "preserve",
      "note": "rate_limit values are header strings, or null when the header is absent. They are never numbers.",
      "request": "q=react",
      "upstream": "no_rate_limit_headers",
      "expect_upstream_url": "q=react&sort=&order=desc&page=1&per_page=30",
      "expect": "empty_ok_null_rate_limit"
    },
    {
      "id": "sort-all",
      "disposition": "preserve",
      "request": "q=react&sort=all",
      "upstream": "empty",
      "expect_upstream_url": "q=react&sort=&order=desc&page=1&per_page=30",
      "expect": "empty_ok"
    },
    {
      "id": "sort-latest",
      "disposition": "preserve",
      "request": "q=react&sort=latest",
      "upstream": "empty",
      "expect_upstream_url": "q=react&sort=updated&order=desc&page=1&per_page=30",
      "expect": "empty_ok"
    },
    {
      "id": "sort-monthly",
      "disposition": "preserve",
      "note": "R-016: fixed UTC duration window; rollback Next.js still sends only the sort.",
      "request": "q=react&sort=monthly",
      "upstream": "empty",
      "expect_upstream_url": "q=react%20created%3A%3E2026-09-29T12%3A34%3A56Z&sort=updated&order=desc&page=1&per_page=30",
      "expect": "empty_ok",
      "now": "2026-10-29T12:34:56Z",
      "next_expect_upstream_url": "q=react&sort=updated&order=desc&page=1&per_page=30"
    },
    {
      "id": "sort-yearly",
      "disposition": "preserve",
      "request": "q=react&sort=yearly",
      "upstream": "empty",
      "expect_upstream_url": "q=react%20created%3A%3E2025-10-29T12%3A34%3A56Z&sort=updated&order=desc&page=1&per_page=30",
      "expect": "empty_ok",
      "now": "2026-10-29T12:34:56Z",
      "note": "R-016: fixed UTC duration window; rollback Next.js still sends only the sort.",
      "next_expect_upstream_url": "q=react&sort=updated&order=desc&page=1&per_page=30"
    },
    {
      "id": "sort-featured",
      "disposition": "preserve",
      "request": "q=react&sort=featured",
      "upstream": "empty",
      "expect_upstream_url": "q=react&sort=stars&order=desc&page=1&per_page=30",
      "expect": "empty_ok"
    },
    {
      "id": "sort-unknown-falls-back",
      "disposition": "preserve",
      "request": "q=react&sort=bogus",
      "upstream": "empty",
      "expect_upstream_url": "q=react&sort=&order=desc&page=1&per_page=30",
      "expect": "empty_ok"
    },
    {
      "id": "sort-empty-falls-back",
      "disposition": "preserve",
      "request": "q=react&sort=",
      "upstream": "empty",
      "expect_upstream_url": "q=react&sort=&order=desc&page=1&per_page=30",
      "expect": "empty_ok"
    },
    {
      "id": "sort-inherited-key-constructor",
      "disposition": "preserve",
      "note": "Names that JavaScript objects inherit, such as constructor, are unknown sort names and fall back like any other.",
      "request": "q=react&sort=constructor",
      "upstream": "empty",
      "expect_upstream_url": "q=react&sort=&order=desc&page=1&per_page=30",
      "expect": "empty_ok"
