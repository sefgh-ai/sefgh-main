      "expect": "empty_ok"
    },
    {
      "id": "sort-navbar-stars-ignored",
      "disposition": "defect",
      "note": "The search navbar sends sort=stars for Most Stars. The API does not know that name, so the choice has no effect. Awaiting an owner decision.",
      "request": "q=react&sort=stars",
      "upstream": "empty",
      "expect_upstream_url": "q=react&sort=&order=desc&page=1&per_page=30",
      "expect": "empty_ok"
    },
    {
      "id": "sort-navbar-updated-ignored",
      "disposition": "defect",
      "note": "The search navbar sends sort=updated for Recently Updated, which is likewise ignored.",
      "request": "q=react&sort=updated",
      "upstream": "empty",
      "expect_upstream_url": "q=react&sort=&order=desc&page=1&per_page=30",
      "expect": "empty_ok"
    },
    {
      "id": "language-and-stars-filters",
      "disposition": "preserve",
      "note": "Filters are appended to q as GitHub qualifiers, then the whole query is percent-encoded once.",
      "request": "q=react&language=TypeScript&stars=%3E100",
      "upstream": "one_repo",
      "expect_upstream_url": "q=react%20language%3ATypeScript%20stars%3A%3E100&sort=&order=desc&page=1&per_page=30",
      "expect": "one_repo_ok"
    },
    {
      "id": "language-with-plus",
      "disposition": "preserve",
      "request": "q=parser&language=C%2B%2B",
      "upstream": "empty",
      "expect_upstream_url": "q=parser%20language%3AC%2B%2B&sort=&order=desc&page=1&per_page=30",
      "expect": "empty_ok"
    },
    {
      "id": "language-with-hash",
