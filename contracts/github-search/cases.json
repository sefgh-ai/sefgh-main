      "disposition": "preserve",
      "request": "q=react&stars=100..500",
      "upstream": "empty",
      "expect_upstream_url": "q=react%20stars%3A100..500&sort=&order=desc&page=1&per_page=30",
      "expect": "empty_ok"
    },
    {
      "id": "stars-greater-or-equal",
