      "request": "q=react&stars=%3E%3D50",
      "upstream": "empty",
      "expect_upstream_url": "q=react%20stars%3A%3E%3D50&sort=&order=desc&page=1&per_page=30",
      "expect": "empty_ok"
    },
    {
      "id": "stars-less-than",
